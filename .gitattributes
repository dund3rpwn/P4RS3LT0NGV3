# Normalise line endings so the repo stays stable across Windows/macOS/Linux.
# Without this, checking out on Windows rewrites LF to CRLF and the next commit
# shows every line of a file as changed.
* text=auto eol=lf

# Binary assets must never be line-ending converted.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pkl  binary
